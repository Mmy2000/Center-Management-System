# Environment variables for a Vercel deployment (free / Hobby plan).
# Nothing here is read from this file by Vercel — paste each name/value into
# Project → Settings → Environment Variables (or `vercel env add <NAME>`), for
# the Production environment. Do not commit a filled-in copy.
#
# Read docs/07-deployment.md §L.3 for what each setting means, and the table at
# the top of docs/12-pythonanywhere.md: the free-tier limits described there
# apply to Vercel almost word for word, plus a read-only filesystem.

# --------------------------------------------------------------------------- #
# Core
# --------------------------------------------------------------------------- #

# cms/settings/vercel.py is prod plus what serverless changes (static files,
# no writable disk, no persistent connections). It inherits prod's refusal to
# start without Postgres, a secret key, ALLOWED_HOSTS and DEBUG=False, which is
# exactly the check you want a deploy to run. api/index.py defaults to this, so
# setting it here is belt and braces.
DJANGO_SETTINGS_MODULE=cms.settings.vercel

# Generate a fresh one — never reuse the development key:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

DEBUG=False

# Your production hostname. Vercel gives every deployment its own URL, so add
# `.vercel.app` too if you want preview deployments to answer as well — the
# leading dot matches any subdomain of it.
ALLOWED_HOSTS=<project>.vercel.app

# Needs the scheme, unlike ALLOWED_HOSTS. Every host that posts a form belongs
# here or every POST is rejected as a CSRF failure.
CSRF_TRUSTED_ORIGINS=https://<project>.vercel.app

# --------------------------------------------------------------------------- #
# Database — required, and not optional on Vercel
# --------------------------------------------------------------------------- #

# The filesystem is read-only apart from /tmp and is thrown away between
# invocations, so SQLite cannot be used at all here: a write would fail, and
# anything written to /tmp disappears. Production settings already require
# Postgres (row locking + partial indexes), so use a managed one — Neon and
# Supabase both have a free tier, and Vercel can provision Neon for you.
#
# Use the POOLED connection string (Neon: the `-pooler` host; Supabase: port
# 6543). Each serverless invocation opens its own connection, and a free
# Postgres runs out of direct connections long before it runs out of anything
# else.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/cms?sslmode=require

# --------------------------------------------------------------------------- #
# Cache — optional, but read the note
# --------------------------------------------------------------------------- #

# Empty falls back to LocMemCache, which on serverless means every instance
# keeps its own copy: per-tenant traffic metering under-reports and each
# instance enforces its own copy of every rate limit (the tenancy.W002 warning
# `manage.py check` prints). Harmless for one center you run yourself; set a
# Redis URL — Upstash has a free tier and installs from the Vercel marketplace —
# before letting other people's centers onto it. With Redis set, prod also moves
# sessions into it instead of the database.
REDIS_URL=

SENTRY_DSN=

TIME_ZONE=Africa/Cairo
LANGUAGE_CODE=ar

# --------------------------------------------------------------------------- #
# Multi-tenancy — the free plan allows one hostname, which decides this
# --------------------------------------------------------------------------- #

# Wildcard domains are a paid Vercel feature, so `<slug>.yourdomain.com` routing
# is not available: one hostname means one center, exactly as in
# docs/12-pythonanywhere.md. With no second host to give the console, it is
# served from a path on the same host instead.
#
# What that costs: the console and the center share an origin, so the
# structural wall is gone and `platform_staff_required` is the only one left. A
# center's staff still cannot read a single row of console data, but they can
# tell it exists. Fine for one center you run yourself; not what you would ship
# for a platform holding other people's data (docs/10 §N.11).
CONSOLE_HOST=
CONSOLE_PATH_PREFIX=platform

# The suffix tenant subdomains hang off. It has no wildcard behind it here, so
# it only shapes the hostname the provisioning wizard suggests.
TENANT_BASE_DOMAIN=<project>.vercel.app

# Read once, by the bootstrap migration, and only if you are carrying over
# existing single-center data: the host that data should answer on. It must
# match the hostname above, or the migrated center answers on a name that no
# request ever arrives with.
DEFAULT_TENANT_HOST=<project>.vercel.app
