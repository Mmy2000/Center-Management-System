# Copy to .env and fill in. Never commit .env.
# See docs/07-deployment.md §L.3.

# dev | prod. cms.settings.pythonanywhere needs no .env at all (docs/07 §L.9).
DJANGO_SETTINGS_MODULE=cms.settings.dev

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,.localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Empty -> SQLite at BASE_DIR/db.sqlite3. Production REQUIRES postgres.
# DATABASE_URL=postgres://cms:password@localhost:5432/cms
DATABASE_URL=

# Empty -> local-memory cache.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

SENTRY_DSN=

TIME_ZONE=Africa/Cairo
LANGUAGE_CODE=ar

# --- Multi-tenancy (docs/10-multi-tenancy.md) ---
# Hostname of the platform console. It gets its own URLconf, so a tenant host
# can never route to it. Leave empty to disable console routing entirely.
CONSOLE_HOST=console.localhost

# The suffix every client's subdomain hangs off: <slug>.TENANT_BASE_DOMAIN is
# the primary host the provisioning wizard creates. In production this is the
# domain you hold a wildcard certificate for.
TENANT_BASE_DOMAIN=localhost

# Only read by the Phase 14 bootstrap migration, and only when there is existing
# single-center data to migrate: the hostname that data should answer on.
DEFAULT_TENANT_HOST=localhost
